# Stripe — from https://dashboard.stripe.com/apikeys
# Use the sk_test_... key while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=

# Resend (optional) — from https://resend.com/api-keys
# Used to email you instantly when someone submits a lead form.
# Leave blank and lead submissions will still work, just without email alerts.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=you@verbaconnect.com
